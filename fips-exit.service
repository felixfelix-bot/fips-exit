[Unit]
Description=fips exit node (IP-in-IPv6 tunnels, NAT and firewall for mesh clients)
After=fips.service network-online.target
Wants=network-online.target
Requires=fips.service

[Service]
Type=oneshot
RemainAfterExit=yes
# fips0 and its address appear a moment after the daemon starts.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do ip -6 addr show dev fips0 2>/dev/null | grep -q "inet6 fd" && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/local/sbin/fips-exit up
ExecStop=/usr/local/sbin/fips-exit down

[Install]
WantedBy=multi-user.target
